# Copie para .env.local e preencha. .env*.local é ignorado pelo git (.gitignore:21).
# Cada git worktree tem o seu .env.local — criar em uma NÃO cria nas outras.
#
# Nada aqui deve conter valor real. Segredo nunca entra em commit, nunca em log,
# e nunca ganha prefixo NEXT_PUBLIC_ (esse prefixo publica a variável no bundle
# que vai para o navegador).

# ─── Supabase ────────────────────────────────────────────────────────────────

# Projeto e chave pública. Vão para o navegador — a chave anon é protegida por
# RLS, é assim que ela é desenhada para funcionar.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Ignora RLS por completo. Usada só em lib/supabase/admin.ts, que tem
# `import "server-only"` justamente para quebrar o build se um Client Component
# tentar importá-la.
#
# Sem esta variável a captura de pedidos e o webhook de assinatura lançam em
# runtime — e o sintoma aparece tarde, já no meio do fluxo, porque todo o resto
# funciona sem ela.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ─── Site ────────────────────────────────────────────────────────────────────

# Base das URLs canônicas (robots, sitemap, metadata) e destino do redirect
# quando uma loja rebaixada perde o domínio próprio. Sem barra no final.
# Ausente, o código usa https://vtrinedigital.com.br.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics. Opcional — ausente, o script simplesmente não é injetado.
NEXT_PUBLIC_GA_ID=

# Ferramenta de suporte: autoriza POST /api/admin/revalidate a limpar o cache do
# catálogo de uma loja. Qualquer string longa e aleatória serve.
ADMIN_REVALIDATE_SECRET=

# ─── Asaas (assinaturas) ─────────────────────────────────────────────────────

# Sandbox: https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3
# Trocar de ambiente é trocar esta linha E a chave abaixo — as duas andam juntas.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Chave da API, enviada no header `access_token`. A do sandbox é distinta da de
# produção. Nunca com prefixo NEXT_PUBLIC_.
#
# A chave do Asaas começa com "$" (ex: $aact_hmlg_...). O Next.js expande
# .env* com dotenv-expand, que interpreta "$algo" não escapado como referência
# a outra variável — "$aact_..." vira vazio em silêncio, sem erro nenhum, e o
# sintoma só aparece depois, como 401 do Asaas num request que parece ter a
# chave certa. Escape o "$" com "\" ao colar a chave aqui: ASAAS_API_KEY=\$aact_...
ASAAS_API_KEY=

# Token que VOCÊ escolhe e registra junto da URL do webhook no painel do Asaas.
# Ele chega de volta no header `asaas-access-token` a cada notificação, e a rota
# compara com timingSafeEqual.
#
# Para receber webhook em desenvolvimento é preciso expor o localhost:
#   cloudflared tunnel --url http://localhost:3000
# e registrar a URL pública resultante + /api/webhooks/asaas no painel.
#
# app/api/webhooks/asaas/route.ts só reage a CHECKOUT_PAID, PAYMENT_CONFIRMED,
# PAYMENT_RECEIVED, PAYMENT_OVERDUE, PAYMENT_REFUNDED e
# PAYMENT_CHARGEBACK_REQUESTED — no cadastro do webhook (painel do Asaas →
# Integrações → Webhooks), marque pelo menos esses eventos. Sem
# PAYMENT_RECEIVED, por exemplo, nenhuma assinatura Pix promove (Pix pula
# PAYMENT_CONFIRMED e dispara só PAYMENT_RECEIVED — ver lib/asaas/events.ts).
ASAAS_WEBHOOK_TOKEN=
